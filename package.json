{
  "name": "arggon-manager",
  "version": "0.4.1",
  "description": "Git-native project management CLI (ArggonManager)",
  "type": "module",
  "workspaces": [
    "lib"
  ],
  "bin": {
    "arggon": "./dist/cli.js"
  },
  "files": [
    "dist/**",
    "templates/",
    "skills/",
    "opencode/",
    "README.md",
    "LICENSE",
    "!**/*.test.*",
    "!dist/test-tmp.*",
    "!dist/test-spawn.*",
    "!dist/pack-fixtures.*"
  ],
  "scripts": {
    "build": "npm run build --workspace @arggondev/lib && tsc -p tsconfig.json && tsc -p tsconfig.typecheck.json && tsc -p tsconfig.e2e.json",
    "build:plugin": "tsx cli/src/build-plugin.ts",
    "check:plugin": "npm run build:plugin && git diff --exit-code -- opencode/plugins/arggon/index.bundle.ts",
    "postbuild": "node cli/write-build-info.mjs && npm run build:plugin",
    "prepare": "npm run build",
    "dev": "tsx cli/src/cli.ts",
    "arggon": "tsx cli/src/cli.ts",
    "skills:sync": "tsx cli/src/sync-skills.ts",
    "context:report": "tsx smoke/context-report.ts",
    "smoke:opencode": "tsx smoke/opencode-smoke.ts",
    "smoke:opencode:wave": "tsx smoke/opencode-wave.ts",
    "smoke:native-start-cold": "tsx smoke/native-start-cold-smoke.ts",
    "smoke:worktree-playwright": "tsx smoke/worktree-playwright-smoke.ts",
    "smoke:tui": "tsx smoke/tui-smoke.ts",
    "smoke:tui-board": "tsx smoke/tui-board-smoke.ts",
    "test": "vitest run",
    "test:property": "vitest run .property.test",
    "test:watch": "vitest",
    "test:structure": "ast-grep test --skip-snapshot-tests --color never && ast-grep scan --threads 1 --report-style short --color never tools/ast-grep/tests/non-plugin-valid.tsx",
    "lint": "eslint .",
    "lint:structure": "ast-grep scan --threads 1 --report-style short --color never",
    "format": "prettier -w ."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@arggondev/lib": "^0.4.0",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "fast-check": "4.10.2",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arggon/ArggonManager.git"
  }
}
