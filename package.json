{
  "name": "arggon-manager",
  "version": "0.3.0",
  "private": true,
  "description": "Git-native project management CLI (ArggonManager)",
  "type": "module",
  "workspaces": [
    "lib"
  ],
  "bin": {
    "arggon": "./dist/cli.js"
  },
  "files": [
    "dist/**",
    "templates/",
    "skills/",
    "opencode/",
    "README.md",
    "LICENSE",
    "!**/*.test.*",
    "!dist/test-tmp.*"
  ],
  "scripts": {
    "build": "npm run build --workspace @arggon/lib && tsc -p tsconfig.json",
    "postbuild": "node cli/write-build-info.mjs",
    "prepare": "npm run build",
    "dev": "tsx cli/src/cli.ts",
    "arggon": "tsx cli/src/cli.ts",
    "skills:sync": "tsx cli/src/sync-skills.ts",
    "context:report": "tsx smoke/context-report.ts",
    "smoke:opencode": "tsx smoke/opencode-smoke.ts",
    "smoke:opencode:wave": "tsx smoke/opencode-wave.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier -w ."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@arggon/lib": "^0.3.0",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^5.0.0"
  }
}
